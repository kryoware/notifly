<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Needed to list installed apps for the allow-list picker. Play Store
         requires a declared justification for this one. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".NotiflyApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.Notifly">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
        </activity>

        <activity-alias android:name=".LauncherUbeSystem"
            android:targetActivity=".MainActivity" android:exported="true" android:enabled="true"
            android:icon="@mipmap/ic_launcher_ube_system"
            android:roundIcon="@mipmap/ic_launcher_ube_system">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherUbeLight"
            android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_ube_light"
            android:roundIcon="@mipmap/ic_launcher_ube_light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherUbeDark"
            android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_ube_dark"
            android:roundIcon="@mipmap/ic_launcher_ube_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherEvergreenSystem"
            android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_evergreen_system"
            android:roundIcon="@mipmap/ic_launcher_evergreen_system">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherEvergreenLight"
            android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_evergreen_light"
            android:roundIcon="@mipmap/ic_launcher_evergreen_light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherEvergreenDark"
            android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_evergreen_dark"
            android:roundIcon="@mipmap/ic_launcher_evergreen_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherIndigoSystem"
            android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_indigo_system"
            android:roundIcon="@mipmap/ic_launcher_indigo_system">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherIndigoLight"
            android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_indigo_light"
            android:roundIcon="@mipmap/ic_launcher_indigo_light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherIndigoDark"
            android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_indigo_dark"
            android:roundIcon="@mipmap/ic_launcher_indigo_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherSlateSystem"
            android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_slate_system"
            android:roundIcon="@mipmap/ic_launcher_slate_system">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherSlateLight"
            android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_slate_light"
            android:roundIcon="@mipmap/ic_launcher_slate_light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherSlateDark"
            android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_slate_dark"
            android:roundIcon="@mipmap/ic_launcher_slate_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherClaySystem"
            android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_clay_system"
            android:roundIcon="@mipmap/ic_launcher_clay_system">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherClayLight"
            android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_clay_light"
            android:roundIcon="@mipmap/ic_launcher_clay_light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherClayDark"
            android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_clay_dark"
            android:roundIcon="@mipmap/ic_launcher_clay_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          Special access, not a runtime permission. The user must enable this in
          system Settings; there is no dialog you can show. The system holds
          BIND_NOTIFICATION_LISTENER_SERVICE, so android:permission is required.
        -->
        <service
            android:name=".service.CaptureMaintenanceService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".service.NotificationCaptureService"
            android:exported="false"
            android:label="@string/notification_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Bypasses SentryInitProvider's auto-init; CrashReporting.start() gates
             init on the user's opt-in preference instead. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />
    </application>
</manifest>
